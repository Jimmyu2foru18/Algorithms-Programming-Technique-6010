   "source": [
    "Conda activate ______\n",
    "conda install numpy\n",
    "\n",
    "\n",
    "int x = new int[10]\n",
    "\"Heap\"\n",
    "allocated at runtime\n",
    "&\n",
    "accessed through a refrence, memory location as its value\n",
    "\n",
    "say int = \"4 bytes\n",
    "                                                    x[3]\n",
    "Stack:                                              x[0]\n",
    "x=0x447 ---------> Heap\n",
    "                      -----------------\n",
    "                0x447 |               |  - 4 bytes\n",
    "                      -----------------0\n",
    "                      |               |\n",
    "                      -----------------1\n",
    "                      |               |          x =[1,Hello,..15,[]1234]\n",
    "                      -----------------2\n",
    "                      |               |\n",
    "                      -----------------3\n",
    "                      |               |\n",
    "                      -----------------4\n",
    "                      |               |\n",
    "                      -----------------5\n",
    "                      |               |\n",
    "                      -----------------6\n",
    "                      |               |\n",
    "                      -----------------7\n",
    "                      |               |\n",
    "                      -----------------8\n",
    "                      |               |\n",
    "                      -----------------9\n",
    "To fix this mess someone made numpy\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "x = np.array([1,2,3,4])\n",
    "\n",
    "    x[3]\n",
    "                In Memory \n",
    "                   x = 0x447 -->  -----------------\n",
    "                                  |               |\n",
    "                                  -----------------0\n",
    "                                  |               |\n",
    "                                  -----------------1\n",
    "                                  |               |\n",
    "                                  -----------------2\n",
    "                                  |               |\n",
    "                                  -----------------3\n",
    "\n",
    "\n",
    "\n"
